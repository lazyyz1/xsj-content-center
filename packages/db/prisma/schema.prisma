generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum IntegrationProvider {
  REDFOX
  DOUBAO_ASR
  LLM
  PUBLISHING
  STORAGE
}

enum IntegrationStatus {
  CONFIGURED
  UNCONFIGURED
  ERROR
  DISABLED
  MOCK
}

enum SourceType {
  TEXT
  URL
  VIDEO
  AUDIO
  IMAGE
  DOCUMENT
}

enum SourcePlatform {
  GENERIC
  DOUYIN
  XIAOHONGSHU
  WECHAT
  BILIBILI
  YOUTUBE
  TIKTOK
  OTHER
}

enum SourceItemStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum IngestJobType {
  EXTRACT_TEXT
  FETCH_URL
  TRANSCRIBE
  PROCESS_MEDIA
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProviderMode {
  REAL
  MOCK
}

enum AssetType {
  VIDEO
  IMAGE
  AUDIO
}

enum AssetStatus {
  REMOTE
  DOWNLOADING
  STORED
  FAILED
}

model User {
  id                   String            @id @default(cuid())
  name                 String
  email                String            @unique
  emailVerified        Boolean           @default(false)
  image                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  accounts             Account[]
  workspaceMemberships WorkspaceMember[]
  auditLogs            AuditLog[]
  createdSources       SourceItem[]      @relation("SourceCreatedBy")
  requestedIngestJobs  IngestJob[]       @relation("IngestRequestedBy")
  createdCollections   Collection[]      @relation("CollectionCreatedBy")
  apiUsages            ApiUsage[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Workspace {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  members      WorkspaceMember[]
  integrations IntegrationConfig[]
  auditLogs    AuditLog[]
  sourceItems  SourceItem[]
  ingestJobs   IngestJob[]
  transcripts  Transcript[]
  contentTags  ContentTag[]
  collections  Collection[]
  sourceAssets SourceAsset[]
  apiUsages    ApiUsage[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model IntegrationConfig {
  id                   String              @id @default(cuid())
  workspaceId          String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(UNCONFIGURED)
  configured           Boolean             @default(false)
  publicConfig         Json?
  encryptedConfig      String?
  lastFour             String?
  encryptionKeyVersion Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([userId])
}

model SourceItem {
  id             String           @id @default(cuid())
  workspaceId    String
  createdById    String
  sourceType     SourceType
  sourcePlatform SourcePlatform   @default(GENERIC)
  sourceUrl      String?
  canonicalUrl   String?
  title          String?
  author         String?
  description    String?
  thumbnailUrl   String?
  rawText        String?
  status         SourceItemStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("SourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  ingestJobs     IngestJob[]
  transcript     Transcript?
  tags           SourceItemTag[]
  collections    CollectionItem[]
  assets         SourceAsset[]

  @@unique([workspaceId, canonicalUrl])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, sourcePlatform])
}

model SourceAsset {
  id             String      @id @default(cuid())
  workspaceId    String
  sourceItemId   String
  assetType      AssetType
  sourceProvider String
  remoteUrl      String?
  storageKey     String?
  mimeType       String?
  sizeBytes      BigInt?
  status         AssetStatus @default(REMOTE)
  metadata       Json?
  storedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem     SourceItem  @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, sourceItemId])
  @@index([sourceItemId, status])
}

model ApiUsage {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String
  provider          String
  operation         String
  requestId         String
  providerRequestId String?
  success           Boolean
  units             Int       @default(1)
  cost              Decimal?
  metadata          Json?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider, operation])
  @@index([requestId])
}

model IngestJob {
  id            String        @id @default(cuid())
  workspaceId   String
  sourceItemId  String
  requestedById String
  jobType       IngestJobType
  provider      String
  providerMode  ProviderMode
  status        JobStatus     @default(QUEUED)
  progress      Int           @default(0)
  attempt       Int           @default(0)
  maxAttempts   Int           @default(3)
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem    SourceItem    @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  requestedBy   User          @relation("IngestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([sourceItemId, createdAt])
}

model Transcript {
  id           String       @id @default(cuid())
  workspaceId  String
  sourceItemId String       @unique
  provider     String
  providerMode ProviderMode
  language     String?
  durationMs   Int?
  fullText     String
  segments     Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem   @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ContentTag {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItems SourceItemTag[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, name])
}

model SourceItemTag {
  sourceItemId String
  tagId        String
  createdAt    DateTime   @default(now())
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  tag          ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sourceItemId, tagId])
  @@index([tagId])
}

model Collection {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceItems CollectionItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model CollectionItem {
  collectionId String
  sourceItemId String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@id([collectionId, sourceItemId])
  @@index([sourceItemId])
}
