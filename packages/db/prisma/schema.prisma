generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum IntegrationProvider {
  REDFOX
  DOUBAO_ASR
  TRANSCRIPTION
  LLM
  PUBLISHING
  STORAGE
}

enum IntegrationStatus {
  CONFIGURED
  UNCONFIGURED
  ERROR
  DISABLED
  MOCK
}

enum SourceType {
  TEXT
  URL
  VIDEO
  AUDIO
  IMAGE
  DOCUMENT
}

enum SourcePlatform {
  GENERIC
  DOUYIN
  XIAOHONGSHU
  WECHAT
  BILIBILI
  YOUTUBE
  TIKTOK
  OTHER
}

enum ContentIdeaStatus {
  INBOX
  READY
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum SourceItemStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum IngestJobType {
  EXTRACT_TEXT
  FETCH_URL
  TRANSCRIBE
  PROCESS_MEDIA
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProviderMode {
  REAL
  MOCK
}

enum AssetType {
  VIDEO
  IMAGE
  AUDIO
}

enum AssetStatus {
  REMOTE
  DOWNLOADING
  STORED
  FAILED
}

enum ContentProjectStatus {
  DRAFT
  RESEARCHING
  BRIEF_READY
  WRITING
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum ProjectSourceRole {
  REFERENCE
  EVIDENCE
  INSPIRATION
  OWN_MATERIAL
}

enum EvidenceType {
  FACT
  VIEWPOINT
  CASE
  DATA
  QUOTE
  EXPERIENCE
  QUESTION
  OTHER
}

enum PromptType {
  ANALYZE_SOURCES
  EXTRACT_EVIDENCE
  GENERATE_ANGLES
  GENERATE_BRIEF
  GENERATE_MOTHER_CONTENT
  REWRITE_SELECTION
  SHORTEN
  EXPAND
  ADD_PERSONAL_VIEW
  HUMANIZE
  ADAPT_PLATFORM
  GENERATE_DEEP_CONTENT_PACKAGE
  REVIEW_PLATFORM_CONTENT
}

enum ReviewResult {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  READY_TO_PUBLISH
  PUBLISHED
  FAILED
  CANCELLED
}

enum AIRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum Platform {
  DOUYIN
  XIAOHONGSHU
  WECHAT_MOMENTS
  WECHAT_CHANNELS
  WECHAT_OFFICIAL
}

enum PlatformVariantStatus {
  DRAFT
  READY
  STALE
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum DeepContentPackageStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

enum MotherContentOrigin {
  HUMAN
  KIMI
  GPT_WEB
}

model User {
  id                      String               @id @default(cuid())
  name                    String
  email                   String               @unique
  emailVerified           Boolean              @default(false)
  image                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  accounts                Account[]
  workspaceMemberships    WorkspaceMember[]
  auditLogs               AuditLog[]
  createdSources          SourceItem[]         @relation("SourceCreatedBy")
  requestedIngestJobs     IngestJob[]          @relation("IngestRequestedBy")
  createdCollections      Collection[]         @relation("CollectionCreatedBy")
  apiUsages               ApiUsage[]
  createdProjects         ContentProject[]     @relation("ProjectCreatedBy")
  createdEvidenceItems    EvidenceItem[]       @relation("EvidenceCreatedBy")
  createdBriefs           CreativeBrief[]      @relation("BriefCreatedBy")
  createdMotherContent    MotherContent[]      @relation("MotherContentCreatedBy")
  creatorProfiles         CreatorProfile[]
  aiRuns                  AIRun[]              @relation("AIRunUser")
  createdPlatformVariants PlatformVariant[]    @relation("PlatformVariantCreatedBy")
  createdDeepPackages     DeepContentPackage[] @relation("DeepContentPackageCreatedBy")
  reviewRecords           ReviewRecord[]       @relation("ReviewRecordReviewer")
  createdPublishTasks     PublishTask[]         @relation("PublishTaskCreatedBy")
  publishedTasks          PublishTask[]         @relation("PublishTaskPublisher")
  createdBenchmarkAccounts BenchmarkAccount[]   @relation("BenchmarkAccountCreatedBy")
  createdContentIdeas     ContentIdea[]          @relation("ContentIdeaCreatedBy")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  members             WorkspaceMember[]
  integrations        IntegrationConfig[]
  auditLogs           AuditLog[]
  sourceItems         SourceItem[]
  ingestJobs          IngestJob[]
  transcripts         Transcript[]
  contentTags         ContentTag[]
  collections         Collection[]
  sourceAssets        SourceAsset[]
  apiUsages           ApiUsage[]
  contentProjects     ContentProject[]
  evidenceItems       EvidenceItem[]
  creativeBriefs      CreativeBrief[]
  motherContents      MotherContent[]
  creatorProfiles     CreatorProfile[]
  promptTemplates     PromptTemplate[]
  platformTemplates   PlatformTemplate[]
  platformVariants    PlatformVariant[]
  deepContentPackages DeepContentPackage[]
  aiRuns              AIRun[]
  reviewRecords       ReviewRecord[]
  publishTasks        PublishTask[]
  benchmarkAccounts   BenchmarkAccount[]
  contentIdeas        ContentIdea[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model IntegrationConfig {
  id                   String              @id @default(cuid())
  workspaceId          String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(UNCONFIGURED)
  configured           Boolean             @default(false)
  publicConfig         Json?
  encryptedConfig      String?
  lastFour             String?
  encryptionKeyVersion Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([userId])
}

model SourceItem {
  id             String           @id @default(cuid())
  workspaceId    String
  createdById    String
  sourceType     SourceType
  sourcePlatform SourcePlatform   @default(GENERIC)
  sourceUrl      String?
  canonicalUrl   String?
  externalId     String?
  sourceProvider String?
  title          String?
  author         String?
  description    String?
  thumbnailUrl   String?
  rawText        String?
  status         SourceItemStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("SourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  ingestJobs     IngestJob[]
  transcript     Transcript?
  tags           SourceItemTag[]
  collections    CollectionItem[]
  assets         SourceAsset[]
  projects       ProjectSource[]
  evidenceItems  EvidenceItem[]
  ideaReferences ContentIdeaReference[]

  @@unique([workspaceId, canonicalUrl])
  @@unique([workspaceId, sourcePlatform, externalId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, sourcePlatform])
}

model SourceAsset {
  id             String      @id @default(cuid())
  workspaceId    String
  sourceItemId   String
  assetType      AssetType
  sourceProvider String
  remoteUrl      String?
  storageKey     String?
  mimeType       String?
  sizeBytes      BigInt?
  status         AssetStatus @default(REMOTE)
  metadata       Json?
  storedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem     SourceItem  @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, sourceItemId])
  @@index([sourceItemId, status])
}

model ApiUsage {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String
  provider          String
  operation         String
  requestId         String
  providerRequestId String?
  success           Boolean
  units             Int       @default(1)
  cost              Decimal?
  inputTokens       Int?
  outputTokens      Int?
  metadata          Json?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider, operation])
  @@index([requestId])
}

model IngestJob {
  id            String        @id @default(cuid())
  workspaceId   String
  sourceItemId  String
  requestedById String
  jobType       IngestJobType
  provider      String
  providerMode  ProviderMode
  status        JobStatus     @default(QUEUED)
  progress      Int           @default(0)
  attempt       Int           @default(0)
  maxAttempts   Int           @default(3)
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem    SourceItem    @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  requestedBy   User          @relation("IngestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([sourceItemId, createdAt])
}

model Transcript {
  id           String       @id @default(cuid())
  workspaceId  String
  sourceItemId String       @unique
  provider     String
  providerMode ProviderMode
  language     String?
  durationMs   Int?
  fullText     String
  segments     Json
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem   @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ContentTag {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItems SourceItemTag[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, name])
}

model SourceItemTag {
  sourceItemId String
  tagId        String
  createdAt    DateTime   @default(now())
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  tag          ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sourceItemId, tagId])
  @@index([tagId])
}

model Collection {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceItems CollectionItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model CollectionItem {
  collectionId String
  sourceItemId String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@id([collectionId, sourceItemId])
  @@index([sourceItemId])
}

model ContentProject {
  id                  String               @id @default(cuid())
  workspaceId         String
  createdById         String
  creatorProfileId    String?
  title               String
  description         String?
  goal                String?
  audience            String?
  status              ContentProjectStatus @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  creatorProfile      CreatorProfile?      @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  sources             ProjectSource[]
  evidenceItems       EvidenceItem[]
  creativeBrief       CreativeBrief?
  motherContent       MotherContent?
  platformVariants    PlatformVariant[]
  deepContentPackages DeepContentPackage[]
  aiRuns              AIRun[]
  reviewRecords       ReviewRecord[]
  publishTasks        PublishTask[]
  contentIdea         ContentIdea?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([createdById])
  @@index([creatorProfileId])
}

model BenchmarkAccount {
  id                String         @id @default(cuid())
  workspaceId       String
  creatorProfileId  String?
  platform          SourcePlatform
  externalAccountId String
  name              String
  avatarUrl         String?
  bio               String?
  originalUrl       String?
  enabled           Boolean        @default(true)
  lastSyncedAt      DateTime?
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorProfile    CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  createdBy         User           @relation("BenchmarkAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, platform, externalAccountId])
  @@index([workspaceId, enabled, updatedAt])
  @@index([creatorProfileId])
}

model ContentIdea {
  id               String            @id @default(cuid())
  workspaceId      String
  creatorProfileId String?
  projectId        String?            @unique
  title            String
  description      String?
  status           ContentIdeaStatus @default(INBOX)
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile?   @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  project          ContentProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy        User              @relation("ContentIdeaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  references       ContentIdeaReference[]

  @@index([workspaceId, status, updatedAt])
  @@index([creatorProfileId])
  @@index([createdById])
}

model ContentIdeaReference {
  id               String         @id @default(cuid())
  ideaId           String
  platform         SourcePlatform
  externalId       String
  title            String
  url              String
  authorName       String?
  coverUrl         String?
  metadataSnapshot Json?
  sourceItemId     String?
  createdAt        DateTime       @default(now())
  idea             ContentIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  sourceItem       SourceItem?     @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@unique([ideaId, platform, externalId])
  @@index([sourceItemId])
}

model ProjectSource {
  id           String            @id @default(cuid())
  projectId    String
  sourceItemId String
  role         ProjectSourceRole @default(REFERENCE)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  project      ContentProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem        @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceItemId])
  @@index([sourceItemId])
  @@index([projectId, sortOrder])
}

model EvidenceItem {
  id           String         @id @default(cuid())
  workspaceId  String
  projectId    String
  sourceItemId String?
  type         EvidenceType
  excerpt      String?
  claim        String?
  note         String?
  sourceUrl    String?
  sortOrder    Int            @default(0)
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem?    @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  createdBy    User           @relation("EvidenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, projectId, sortOrder])
  @@index([sourceItemId])
  @@index([createdById])
}

model CreativeBrief {
  id          String         @id @default(cuid())
  workspaceId String
  projectId   String         @unique
  topic       String
  angle       String
  audience    String
  coreMessage String
  keyPoints   Json
  structure   Json
  tone        String
  risks       Json
  version     Int            @default(1)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("BriefCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, updatedAt])
  @@index([createdById])
}

model MotherContent {
  id               String              @id @default(cuid())
  workspaceId      String
  projectId        String              @unique
  title            String
  body             String
  outline          Json
  version          Int                 @default(1)
  origin           MotherContentOrigin @default(HUMAN)
  originNote       String?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          ContentProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User                @relation("MotherContentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  platformVariants PlatformVariant[]

  @@index([workspaceId, updatedAt])
  @@index([createdById])
}

model CreatorProfile {
  id                   String               @id @default(cuid())
  workspaceId          String
  userId               String
  displayName          String               @default("")
  positioning          String               @default("")
  targetAudience       String               @default("")
  tone                 String               @default("")
  preferredStyle       String               @default("")
  forbiddenStyle       String               @default("")
  coreTopics           Json
  personalViews        Json
  brandTerms           Json
  forbiddenTerms       Json
  hookPreferences      Json
  structurePreferences Json
  ctaPreferences       Json
  examplePhrases       Json
  notes                String               @default("")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects             ContentProject[]
  benchmarkAccounts    BenchmarkAccount[]
  contentIdeas         ContentIdea[]
  deepContentPackages  DeepContentPackage[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model DeepContentPackage {
  id                   String                   @id @default(cuid())
  workspaceId          String
  projectId            String
  creatorProfileId     String?
  version              Int
  status               DeepContentPackageStatus @default(DRAFT)
  topicPackage         Json
  viewpointPackage     Json
  evidencePackage      Json
  expressionPackage    Json
  structurePackage     Json
  creatorContribution  Json
  recommendedDirection String
  risks                Json
  needsConfirmation    Json
  createdById          String
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              ContentProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorProfile       CreatorProfile?          @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  createdBy            User                     @relation("DeepContentPackageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@index([workspaceId, projectId, status])
  @@index([creatorProfileId])
  @@index([createdById])
}

model PromptTemplate {
  id           String     @id @default(cuid())
  workspaceId  String?
  name         String
  type         PromptType
  version      Int
  systemPrompt String
  template     String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiRuns       AIRun[]

  @@unique([workspaceId, type, version])
  @@index([type, isActive, version])
  @@index([workspaceId, type, isActive])
}

model PlatformTemplate {
  id           String     @id @default(cuid())
  workspaceId  String?
  platform     Platform
  name         String
  version      Int
  systemPrompt String
  template     String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiRuns       AIRun[]

  @@unique([workspaceId, platform, version])
  @@index([platform, isActive, version])
  @@index([workspaceId, platform, isActive])
}

model PlatformVariant {
  id                  String                @id @default(cuid())
  workspaceId         String
  projectId           String
  motherContentId     String
  platform            Platform
  version             Int                   @default(1)
  title               String?
  body                String
  hook                String?
  summary             String?
  hashtags            Json
  mediaPlan           Json
  metadata            Json
  status              PlatformVariantStatus @default(DRAFT)
  sourceMotherVersion Int
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             ContentProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  motherContent       MotherContent         @relation(fields: [motherContentId], references: [id], onDelete: Cascade)
  createdBy           User                  @relation("PlatformVariantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewRecords       ReviewRecord[]
  publishTasks        PublishTask[]

  @@unique([projectId, platform])
  @@index([workspaceId, projectId])
  @@index([workspaceId, platform, updatedAt])
  @@index([motherContentId])
  @@index([createdById])
}

model ReviewRecord {
  id                String          @id @default(cuid())
  workspaceId       String
  projectId         String
  platformVariantId String
  reviewerId        String
  result            ReviewResult    @default(PENDING)
  issues            Json
  comment           String?
  aiReviewed        Boolean         @default(false)
  aiRunId           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           ContentProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platformVariant   PlatformVariant @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)
  reviewer          User            @relation("ReviewRecordReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  aiRun             AIRun?          @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId, createdAt])
  @@index([platformVariantId, createdAt])
  @@index([reviewerId])
  @@index([aiRunId])
}

model PublishTask {
  id                String          @id @default(cuid())
  workspaceId       String
  projectId         String
  platformVariantId String
  platform          Platform
  status            PublishStatus   @default(DRAFT)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  publisherId       String?
  createdById       String
  externalUrl       String?
  externalPostId    String?
  note              String?
  contentSnapshot   Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           ContentProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platformVariant   PlatformVariant @relation(fields: [platformVariantId], references: [id], onDelete: Restrict)
  createdBy         User            @relation("PublishTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publisher         User?           @relation("PublishTaskPublisher", fields: [publisherId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, scheduledAt])
  @@index([workspaceId, platform, createdAt])
  @@index([projectId, createdAt])
  @@index([platformVariantId, createdAt])
  @@index([createdById])
  @@index([publisherId])
}

model AIRun {
  id                 String            @id @default(cuid())
  workspaceId        String
  projectId          String
  userId             String
  action             PromptType
  provider           String
  model              String
  providerRequestId  String?
  promptTemplateId   String?
  platformTemplateId String?
  promptVersion      Int
  status             AIRunStatus       @default(QUEUED)
  inputSummary       Json
  metadata           Json?
  outputJson         Json?
  contextTruncated   Boolean           @default(false)
  inputTokens        Int?
  outputTokens       Int?
  cost               Decimal?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime          @default(now())
  finishedAt         DateTime?
  appliedAt          DateTime?
  discardedAt        DateTime?
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            ContentProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User              @relation("AIRunUser", fields: [userId], references: [id], onDelete: Restrict)
  promptTemplate     PromptTemplate?   @relation(fields: [promptTemplateId], references: [id], onDelete: Restrict)
  platformTemplate   PlatformTemplate? @relation(fields: [platformTemplateId], references: [id], onDelete: Restrict)
  reviewRecords      ReviewRecord[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId, createdAt])
  @@index([projectId, action, createdAt])
  @@index([userId])
  @@index([platformTemplateId])
}
