DATABASE_URL=postgresql://content_center:content_center_dev@127.0.0.1:55432/content_center?schema=public

REDIS_URL=redis://localhost:6379

AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Generate a random 32-byte base64 key. Example command: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

STORAGE_DRIVER=S3_COMPATIBLE
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=content-center
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Render Media Relay production mode. Keep unset for local MinIO development.
MEDIA_STORAGE_ROOT=
MEDIA_RELAY_INTERNAL_BASE_URL=
MEDIA_RELAY_BASE_URL=
MEDIA_RELAY_INTERNAL_SECRET=
MEDIA_RELAY_SIGNING_SECRET=
ASR_AUDIO_RETENTION_HOURS=24

MOCK_MODE=false

# Internal multi-user access
ALLOW_PUBLIC_SIGNUP=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Production providers are server-managed. Leave false only for local workspace-scoped development.
SYSTEM_MANAGED_PROVIDERS=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL_ID=
REDFOX_API_KEY=
REDFOX_BASE_URL=
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_ASR_BASE_URL=
DOUBAO_ASR_RESOURCE_ID=
TRANSCRIPTION_PRIMARY=
LOCAL_ASR_ENDPOINT=
