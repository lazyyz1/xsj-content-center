{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "APP_URL",
    "STORAGE_DRIVER",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "MEDIA_STORAGE_ROOT",
    "MEDIA_RELAY_INTERNAL_BASE_URL",
    "MEDIA_RELAY_BASE_URL",
    "MEDIA_RELAY_INTERNAL_SECRET",
    "MEDIA_RELAY_SIGNING_SECRET",
    "ASR_AUDIO_RETENTION_HOURS",
    "INTEGRATION_ENCRYPTION_KEY",
    "MOCK_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
